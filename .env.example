# Copy to .env and fill in. mini-colo reads .env from its working directory.

# Status endpoint of the power meter; must return JSON with aenergy.total
# (Wh) and temperature.tC.
POWER_STATUS_URL=
# SSH destination of the router that runs vnstat 1.x, and the interface to
# measure. The user running mini-colo must be able to ssh there without a
# password prompt.
ROUTER_HOST=
NETWORK_INTERFACE=

# Optional: shows a cost next to energy totals.
ENERGY_UNIT_PRICE_PER_KWH=
ENERGY_CURRENCY=

# Optional: the name shown on the dashboard and reports, and an image file
# (.ico, .png or .svg) to use as their browser-tab icon.
#DASHBOARD_TITLE=mini-colo
#DASHBOARD_FAVICON=favicon.png

# Optional: the day of the month (1-31) each monthly report starts on, for
# example to match a billing cycle. Also set it in the OnCalendar= line of
# deploy/mini-colo-report.timer.
#REPORT_START_DAY=1

# Optional, with their defaults.
#LISTEN_ADDR=:8080
#DB_PATH=mini-colo.db
#COLLECT_INTERVAL=1h
