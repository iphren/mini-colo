# Copy to .env and fill in. mini-colo reads .env from its working directory.

# Status endpoint of the power meter; must return JSON with aenergy.total
# (Wh) and temperature.tC.
POWER_STATUS_URL=
# SSH destination of the router that runs vnstat 1.x, and the interface to
# measure. The user running mini-colo must be able to ssh there without a
# password prompt.
ROUTER_HOST=
NETWORK_INTERFACE=

# Optional: shows a cost next to energy totals.
ENERGY_UNIT_PRICE_PER_KWH=
ENERGY_CURRENCY=

# Optional, with their defaults.
#LISTEN_ADDR=:8080
#DB_PATH=mini-colo.db
#COLLECT_INTERVAL=1m
